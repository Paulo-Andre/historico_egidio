# Copie para .env apenas se precisar sobrescrever os padrões.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.17

# Ao publicar atrás de HTTPS/Cloudflare:
# DJANGO_ALLOWED_HOSTS=historico.seudominio.com
# DJANGO_SECURE_COOKIES=1
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=31536000

# Opcional: se não informar, uma chave forte é criada automaticamente em data/.django_secret_key
# DJANGO_SECRET_KEY=
